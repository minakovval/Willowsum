/* DS-11: light theme by default and when chosen. */
:root,
[data-theme="light"] {
  color-scheme: light;
  --ws-surface-100: #FBFBFA;
  --ws-surface-200: #FFFFFF;
  --ws-surface-300: #F1F1EF;
  --ws-ink: #1B2230;
  --ws-ink-muted: #566174;
  --ws-line: #E5E5E2;
  --ws-border-control: #7B8494;
  --ws-brand: #0B2545;
  --ws-brand-hover: #173A66;
  --ws-brand-pressed: #061833;
  --ws-on-brand: #F6F1E8;
  --ws-brand-2: #1D4E89;
  --ws-accent: #E3A33B;
  --ws-on-accent: #0B2545;
  --ws-link: #1D4E89;
  --ws-focus: #1D4E89;
  --ws-gain: #27704C;
  --ws-loss: #B23A3A;
  --ws-disabled-bg: #E7E1D3;
  --ws-disabled-ink: #8A8F99;
  --ws-overlay: rgba(11, 37, 69, 0.45);
  --ws-shadow-raised: 0 1px 2px rgba(11, 37, 69, 0.10), 0 4px 12px rgba(11, 37, 69, 0.06);
  --ws-chart-1: var(--ws-brand);
  --ws-chart-2: var(--ws-brand-2);
  --ws-chart-3: var(--ws-ink-muted);
  --ws-chart-4: var(--ws-border-control);
  --ws-chart-other: repeating-linear-gradient(45deg, var(--ws-ink-muted) 0 3px, var(--ws-surface-200) 3px 6px);
  --ws-chart-area-5: color-mix(in srgb, var(--ws-ink-muted) 45%, var(--ws-surface-200));
  --ws-heat-0: var(--ws-surface-300);
  --ws-heat-1: color-mix(in srgb, var(--ws-brand) 25%, var(--ws-surface-200));
  --ws-heat-2: color-mix(in srgb, var(--ws-brand) 50%, var(--ws-surface-200));
  --ws-heat-3: color-mix(in srgb, var(--ws-brand) 75%, var(--ws-surface-200));
  --ws-heat-4: var(--ws-brand);
  --ws-chart-loss-hatch: repeating-linear-gradient(45deg, var(--ws-loss) 0 3px, var(--ws-surface-200) 3px 6px);
  --ws-mark-large: var(--ws-brand);
  --ws-mark-middle: var(--ws-brand-2);
  --ws-mark-small: var(--ws-accent);
}

/* DS-11: dark theme when chosen. */
[data-theme="dark"] {
  color-scheme: dark;
  --ws-surface-100: #0B2545;
  --ws-surface-200: #12305A;
  --ws-surface-300: #1B3F6E;
  --ws-ink: #F6F1E8;
  --ws-ink-muted: #9DB2C8;
  --ws-line: #24456F;
  --ws-border-control: #6F8CB0;
  --ws-brand: #EBDFC6;
  --ws-brand-hover: #F3EAD6;
  --ws-brand-pressed: #D8CBAE;
  --ws-on-brand: #0B2545;
  --ws-brand-2: #9DB2C8;
  --ws-accent: #E3A33B;
  --ws-on-accent: #0B2545;
  --ws-link: #9DB2C8;
  --ws-focus: #E3A33B;
  --ws-gain: #58C38F;
  --ws-loss: #F09090;
  --ws-disabled-bg: #1B3F6E;
  --ws-disabled-ink: #6F86A6;
  --ws-overlay: rgba(0, 0, 0, 0.6);
  --ws-shadow-raised: 0 1px 2px rgba(0, 0, 0, 0.40);
  --ws-chart-1: var(--ws-brand);
  --ws-chart-2: var(--ws-brand-2);
  --ws-chart-3: var(--ws-ink-muted);
  --ws-chart-4: var(--ws-border-control);
  --ws-chart-other: repeating-linear-gradient(45deg, var(--ws-ink-muted) 0 3px, var(--ws-surface-200) 3px 6px);
  --ws-chart-area-5: color-mix(in srgb, var(--ws-ink-muted) 45%, var(--ws-surface-200));
  --ws-heat-0: var(--ws-surface-300);
  --ws-heat-1: color-mix(in srgb, var(--ws-brand) 25%, var(--ws-surface-200));
  --ws-heat-2: color-mix(in srgb, var(--ws-brand) 50%, var(--ws-surface-200));
  --ws-heat-3: color-mix(in srgb, var(--ws-brand) 75%, var(--ws-surface-200));
  --ws-heat-4: var(--ws-brand);
  --ws-chart-loss-hatch: repeating-linear-gradient(45deg, var(--ws-loss) 0 3px, var(--ws-surface-200) 3px 6px);
  --ws-mark-large: var(--ws-brand);
  --ws-mark-middle: var(--ws-brand-2);
  --ws-mark-small: var(--ws-accent);
}

/* DS-11: «Як у системі» — no data-theme on the root element. */
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --ws-surface-100: #0B2545;
    --ws-surface-200: #12305A;
    --ws-surface-300: #1B3F6E;
    --ws-ink: #F6F1E8;
    --ws-ink-muted: #9DB2C8;
    --ws-line: #24456F;
    --ws-border-control: #6F8CB0;
    --ws-brand: #EBDFC6;
    --ws-brand-hover: #F3EAD6;
    --ws-brand-pressed: #D8CBAE;
    --ws-on-brand: #0B2545;
    --ws-brand-2: #9DB2C8;
    --ws-accent: #E3A33B;
    --ws-on-accent: #0B2545;
    --ws-link: #9DB2C8;
    --ws-focus: #E3A33B;
    --ws-gain: #58C38F;
    --ws-loss: #F09090;
    --ws-disabled-bg: #1B3F6E;
    --ws-disabled-ink: #6F86A6;
    --ws-overlay: rgba(0, 0, 0, 0.6);
    --ws-shadow-raised: 0 1px 2px rgba(0, 0, 0, 0.40);
    --ws-chart-1: var(--ws-brand);
    --ws-chart-2: var(--ws-brand-2);
    --ws-chart-3: var(--ws-ink-muted);
    --ws-chart-4: var(--ws-border-control);
    --ws-chart-other: repeating-linear-gradient(45deg, var(--ws-ink-muted) 0 3px, var(--ws-surface-200) 3px 6px);
    --ws-chart-area-5: color-mix(in srgb, var(--ws-ink-muted) 45%, var(--ws-surface-200));
    --ws-heat-0: var(--ws-surface-300);
    --ws-heat-1: color-mix(in srgb, var(--ws-brand) 25%, var(--ws-surface-200));
    --ws-heat-2: color-mix(in srgb, var(--ws-brand) 50%, var(--ws-surface-200));
    --ws-heat-3: color-mix(in srgb, var(--ws-brand) 75%, var(--ws-surface-200));
    --ws-heat-4: var(--ws-brand);
    --ws-chart-loss-hatch: repeating-linear-gradient(45deg, var(--ws-loss) 0 3px, var(--ws-surface-200) 3px 6px);
    --ws-mark-large: var(--ws-brand);
    --ws-mark-middle: var(--ws-brand-2);
    --ws-mark-small: var(--ws-accent);
  }
}

/* DS-10: width classes. */
@media (min-width: 600px) {
  :root {
    --ws-columns: 8;
    --ws-page-margin: 24px;
    --ws-gutter: 24px;
    --ws-band-gap: 32px;
    --ws-card-padding: 24px;
  }
}
@media (min-width: 1024px) {
  :root {
    --ws-columns: 12;
    --ws-page-margin: 32px;
    --ws-gutter: 24px;
    --ws-band-gap: 48px;
    --ws-card-padding: 24px;
  }
}

/* DS-13: reduced motion — transitions become instant, the spinner slows down. */
@media (prefers-reduced-motion: reduce) {
  :root {
    --ws-duration-interaction: 0.01ms;
    --ws-duration-spinner: 2400ms;
  }
}

/* DS-11 edge case: printing always uses the light theme. */
@media print {
  :root:not([data-theme="light"]),
  :root,
  [data-theme] {
    color-scheme: light;
    --ws-surface-100: #FBFBFA;
    --ws-surface-200: #FFFFFF;
    --ws-surface-300: #F1F1EF;
    --ws-ink: #1B2230;
    --ws-ink-muted: #566174;
