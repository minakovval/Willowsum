/* DS-11: light theme by default and when chosen. */
:root,
[data-theme="light"] {
  color-scheme: light;
  --ws-surface-100: #FBFBFA;
  --ws-surface-200: #FFFFFF;
  --ws-surface-300: #F1F1EF;
  --ws-ink: #1B2230;
  --ws-ink-muted: #566174;
  --ws-line: #E5E5E2;
  --ws-border-control: #7B8494;
  --ws-brand: #0B2545;
  --ws-brand-hover: #173A66;
  --ws-brand-pressed: #061833;
  --ws-on-brand: #F6F1E8;
  --ws-brand-2: #1D4E89;
  --ws-accent: #E3A33B;
  --ws-on-accent: #0B2545;
  --ws-link: #1D4E89;
  --ws-focus: #1D4E89;
  --ws-gain: #27704C;
  --ws-loss: #B23A3A;
  --ws-disabled-bg: #E7E1D3;
  --ws-disabled-ink: #8A8F99;
  --ws-overlay: rgba(11, 37, 69, 0.45);
  --ws-surface-inset: #FAFAF8;
  --ws-tint-info: #EEF2F7;
  --ws-tint-warning: #FBF3E8;
  --ws-on-warning: #7A4505;
  --ws-tint-positive: #E9F3EE;
  --ws-tint-negative: #F8ECEC;
  --ws-skeleton: #ECEEF1;
  --ws-chart-cat-1: #5872D2;
  --ws-chart-cat-2: #0E9161;
  --ws-chart-cat-3: #9C7305;
  --ws-chart-cat-4: #097FCD;
  --ws-chart-cat-5: #C35047;
  --ws-chart-cat-6: #9B5BB6;
  --ws-chart-cat-7: #0F899B;
  --ws-chart-cat-8: #678800;
  --ws-chart-group-income-1: #BA4E84;
  --ws-chart-group-income-2: #BE590F;
  --ws-chart-transfer: #9DB2C8;
  --ws-chart-other: #9AA3AF;
  --ws-chart-reference: rgba(27, 34, 48, 0.6);
  --ws-usage-0: #0E7A3B;
  --ws-usage-30: #34A853;
  --ws-usage-55: #7CC242;
  --ws-usage-75: #C9C21A;
  --ws-usage-95: #FBBC05;
  --ws-over-1: #E3A39B;
  --ws-over-2: #DE7A6F;
  --ws-over-3: #E5584A;
  --ws-over-4: #F2281A;
  --ws-over-5: #D21C10;
  --ws-over-6: #B5180C;
  --ws-over-7: #94130A;
  --ws-over-8: #7A0F08;
  --ws-goal-0: #FFD000;
  --ws-goal-25: #E6CF1A;
  --ws-goal-55: #9ACD32;
  --ws-goal-80: #4CAF50;
  --ws-goal-100: #2E7D32;
  --ws-goal-paused: #C5CAD1;
  --ws-scrim: rgba(11, 37, 69, 0.36);
  --ws-shadow-raised: 0 1px 2px rgba(11, 37, 69, 0.10), 0 4px 12px rgba(11, 37, 69, 0.06);
  --ws-shadow-popover: 0 8px 24px rgba(11, 37, 69, 0.16);
  --ws-shadow-dialog: 0 2px 4px rgba(11, 37, 69, 0.06), 0 24px 48px rgba(11, 37, 69, 0.20);
  --ws-chart-1: var(--ws-brand);
  --ws-chart-2: var(--ws-brand-2);
  --ws-chart-3: var(--ws-ink-muted);
  --ws-chart-4: var(--ws-border-control);
  --ws-chart-other-hatch: repeating-linear-gradient(45deg, var(--ws-ink-muted) 0 3px, var(--ws-surface-200) 3px 6px);
  --ws-chart-area-5: color-mix(in srgb, var(--ws-ink-muted) 45%, var(--ws-surface-200));
  --ws-heat-0: var(--ws-surface-300);
  --ws-heat-1: color-mix(in srgb, var(--ws-brand) 25%, var(--ws-surface-200));
  --ws-heat-2: color-mix(in srgb, var(--ws-brand) 50%, var(--ws-surface-200));
  --ws-heat-3: color-mix(in srgb, var(--ws-brand) 75%, var(--ws-surface-200));
  --ws-heat-4: var(--ws-brand);
  --ws-chart-loss-hatch: repeating-linear-gradient(45deg, var(--ws-loss) 0 3px, var(--ws-surface-200) 3px 6px);
  --ws-mark-large: var(--ws-brand);
  --ws-mark-middle: var(--ws-brand-2);
  --ws-mark-small: var(--ws-accent);
}

