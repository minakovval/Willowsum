/* DS-10: width classes. */
@media (min-width: 600px) {
  :root {
    --ws-columns: 8;
    --ws-page-margin: 24px;
    --ws-gutter: 24px;
    --ws-band-gap: 32px;
    --ws-card-padding: 24px;
  }
}
@media (min-width: 1024px) {
  :root {
    --ws-columns: 12;
    --ws-page-margin: 32px;
    --ws-gutter: 24px;
    --ws-band-gap: 48px;
    --ws-card-padding: 24px;
  }
}

/* DS-13: reduced motion — transitions become instant, the spinner slows down. */
@media (prefers-reduced-motion: reduce) {
  :root {
    --ws-duration-interaction: 0.01ms;
    --ws-duration-spinner: 2400ms;
  }
}

/* DS-11 edge case: printing always uses the light theme. */
@media print {
  :root:not([data-theme="light"]),
  :root,
  [data-theme] {
    color-scheme: light;
    --ws-surface-100: #FBFBFA;
    --ws-surface-200: #FFFFFF;
    --ws-surface-300: #F1F1EF;
    --ws-ink: #1B2230;
    --ws-ink-muted: #566174;
    --ws-line: #E5E5E2;
    --ws-border-control: #7B8494;
    --ws-brand: #0B2545;
    --ws-brand-hover: #173A66;
    --ws-brand-pressed: #061833;
    --ws-on-brand: #F6F1E8;
    --ws-brand-2: #1D4E89;
    --ws-accent: #E3A33B;
    --ws-on-accent: #0B2545;
    --ws-link: #1D4E89;
