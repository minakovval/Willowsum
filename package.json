{
  "name": "willowsum",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm -r run test",
    "dev": "pnpm --filter @willowsum/web dev",
    "check:modules": "pnpm --filter @willowsum/api check:modules",
    "test:integration": "pnpm --filter @willowsum/api test:integration",
    "new-module": "pnpm --filter @willowsum/api new-module"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
