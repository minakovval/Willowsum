{
  "name": "@willowsum/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode ci",
    "build:production": "vite build --mode production",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p e2e/tsconfig.json",
    "test": "vitest run",
    "e2e": "vite build --mode ci && playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "@willowsum/api-contract": "workspace:*",
    "@willowsum/i18n": "workspace:*",
    "@willowsum/ui": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "29.1.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
