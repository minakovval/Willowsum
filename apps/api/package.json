{
  "name": "@willowsum/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check:modules": "node scripts/check-modules.ts",
    "check:schema": "node scripts/check-schema.ts",
    "check:migrations": "node scripts/check-migrations.ts",
    "check:flags": "node scripts/check-flags.ts",
    "contract:write": "node scripts/contract.ts --write",
    "contract:check": "node scripts/contract.ts --check",
    "contract:compat": "node scripts/contract.ts --compat",
    "new-module": "node scripts/new-module.ts",
    "events:snapshot": "node scripts/events-snapshot.ts",
    "migrate": "node scripts/migrate.ts",
    "db:bootstrap": "node scripts/db-bootstrap.ts",
    "start": "node src/main.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.300.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-logs": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@willowsum/domain-kernel": "workspace:*",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "@willowsum/api-contract": "workspace:*",
    "@willowsum/synthetic": "workspace:*",
    "dependency-cruiser": "18.7.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
